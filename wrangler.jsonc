// The top level is what `wrangler dev` and the tests run. `staging` and
// `production` are what CI deploys (ADR-0021 in sisi-j/ash). Their database
// ids stay zero here: scripts/deploy.mjs creates each database on its first
// deploy and fills its id into the CI checkout only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ash-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // Replaced at deploy with the commit being deployed.
    "COMMIT": "dev",
    // Where the ASSETS bucket is served publicly (news covers, later cosmetics).
    "ASSETS_URL": "http://localhost:8787/assets",
    // Cloudflare Access for /admin. Empty means /admin refuses everything.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ash-assets-local" }],
  // Daily, at a quiet hour: delete accounts with no sign-in for a year.
  "triggers": { "crons": ["17 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ash-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "ash-backend-staging",
      "routes": [{ "pattern": "api-staging.ashlauncher.com", "custom_domain": true }],
      "workers_dev": false,
      "vars": {
        "COMMIT": "dev",
        "ASSETS_URL": "https://cdn-staging.ashlauncher.com",
        "ACCESS_TEAM_DOMAIN": "ashlauncher.cloudflareaccess.com",
        "ACCESS_AUD": "f36f5641fc0218b3c05a0c9e2f97f1a531aee3864c5e2d19c25deb6b21f025cd"
      },
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ash-assets-staging" }],
      "triggers": { "crons": ["17 4 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ash-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "ash-backend-production",
      "routes": [{ "pattern": "api.ashlauncher.com", "custom_domain": true }],
      "workers_dev": false,
      "vars": {
        "COMMIT": "dev",
        "ASSETS_URL": "https://cdn.ashlauncher.com",
        "ACCESS_TEAM_DOMAIN": "ashlauncher.cloudflareaccess.com",
        "ACCESS_AUD": "f36f5641fc0218b3c05a0c9e2f97f1a531aee3864c5e2d19c25deb6b21f025cd"
      },
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ash-assets-production" }],
      "triggers": { "crons": ["17 4 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ash-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
